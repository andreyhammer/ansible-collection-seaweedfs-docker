# Managed by Ansible (andreyhammer.seaweedfs_docker). Do not edit.
services:
  filer:
    image: {{ seaweed_image }}
    container_name: {{ filer_container_name }}
    network_mode: host
    restart: unless-stopped
{% set filer_env = seaweed_environment | combine(filer_environment | combine(filer_postgres_env if filer_postgres_enabled else {})) %}
{% if filer_env | length > 0 %}
    environment:
{% for key, value in filer_env.items() %}
      {{ key }}: {{ value | string | replace('$', '$$') | to_json }}
{% endfor %}
{% endif %}
    volumes:
      - {{ filer_project_dir }}:/data
{% for cfg in filer_config_files %}
      - {{ cfg.dest }}:{{ cfg.container_path }}{{ ':ro' if cfg.read_only | default(true) | bool else '' }}
{% endfor %}
{% for item in filer_extra_volumes %}
      - {{ item }}
{% endfor %}
{% if seaweed_localtime | bool %}
      - /etc/localtime:/etc/localtime:ro
{% endif %}
{% if filer_logging | length > 0 %}
    logging:
{{ filer_logging | to_nice_yaml(indent=2) | trim | indent(6, true) }}
{% endif %}
    command:
      - filer
      - -master={{ masters }}
      - -port={{ filer_port }}
      - -ip={{ (seaweed_ip | default(ansible_host, true)) }}
{% if filer_s3_enabled %}
      - -s3
      - -s3.port={{ filer_s3_port }}
{% if filer_s3_idle_timeout | string | length > 0 %}
      - -s3.idleTimeout={{ filer_s3_idle_timeout }}
{% endif %}
{% endif %}
{% for arg in filer_extra_args %}
      - {{ arg | string | replace('$', '$$') | to_json }}
{% endfor %}
